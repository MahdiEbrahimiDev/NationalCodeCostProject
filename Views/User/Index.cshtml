<form method="post">

    <input asp-for="NationalCode"
           class="form-control mb-2"
           placeholder="کد ملی" />

    <span asp-validation-for="NationalCode"
          class="text-danger"></span>

    <button class="btn btn-primary w-100">
        نمایش هزینه
    </button>

</form>

<div class="text-danger mt-2">
    @Model.Price
</div>